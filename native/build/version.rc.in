#include "winver.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PRODUCT_VERSION_MAJOR@,@PRODUCT_VERSION_MINOR@,@PRODUCT_VERSION_PATCH@,0
PRODUCTVERSION  @PRODUCT_VERSION_MAJOR@,@PRODUCT_VERSION_MINOR@,@PRODUCT_VERSION_PATCH@,0
FILEFLAGSMASK   VS_FF_DEBUG
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TorrentSharp.Wrap (native library)\0"
            VALUE "FileVersion", "@PRODUCT_VERSION_MAJOR@.@PRODUCT_VERSION_MINOR@.@PRODUCT_VERSION_PATCH@\0"
            VALUE "InternalName", "tsw\0"
            VALUE "OriginalFilename", "tsw\0"
            VALUE "ProductName", "TorrentSharp.Wrap\0"
            VALUE "ProductVersion", "@PRODUCT_VERSION_MAJOR@.@PRODUCT_VERSION_MINOR@.@PRODUCT_VERSION_PATCH@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END